{
    "name": "hermeteam-dashboard",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.6.0"
    },
    "scripts": {
        "test:server": "node --experimental-strip-types --test tests/*.test.ts",
        "test:web": "vitest run --config vitest.web.config.ts",
        "test": "npm run test:server && npm run test:web",
        "test:e2e": "../scripts/dashboard-e2e-smoke.sh",
        "typecheck": "tsc --noEmit",
        "build": "vite build",
        "check": "npm run typecheck && npm test"
    },
    "devDependencies": {
        "@playwright/test": "1.61.0",
        "@testing-library/jest-dom": "^6.8.0",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^22.15.0",
        "@types/react": "^19.1.11",
        "@types/react-dom": "^19.1.7",
        "@vitejs/plugin-react": "^5.0.2",
        "jsdom": "^26.1.0",
        "typescript": "^5.8.3",
        "vite": "^7.1.5",
        "vitest": "^3.2.4"
    },
    "dependencies": {
        "@tanstack/react-query": "^5.87.4",
        "react": "^19.1.1",
        "react-dom": "^19.1.1"
    }
}
