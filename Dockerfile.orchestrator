ARG HERMES_BASE_IMAGE=nousresearch/hermes-agent:latest
FROM ${HERMES_BASE_IMAGE}

USER root

ARG SUPERCRONIC_VERSION=v0.2.34
ARG TARGETARCH

RUN set -eux; \
    python3 -c 'import os, stat, urllib.request; version=os.environ.get("SUPERCRONIC_VERSION", "v0.2.34"); arch=os.environ.get("TARGETARCH", "amd64"); suffix="linux-arm64" if arch == "arm64" else "linux-amd64"; target="/usr/local/bin/supercronic"; urllib.request.urlretrieve(f"https://github.com/aptible/supercronic/releases/download/{version}/supercronic-{suffix}", target); mode=os.stat(target).st_mode; os.chmod(target, mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)'

# Hermes ships the Langfuse observer plugin but keeps its SDK optional.
# Bake the SDK into the managed image so enabling observability/langfuse is deterministic.
RUN python3 -m pip install --no-cache-dir langfuse

COPY orchestrator /opt/hermes-sdlc-orchestrator
COPY hermes-plugins/hermeteam-intent-action-gate /root/.hermes/plugins/hermeteam-intent-action-gate
ENV PYTHONPATH=/opt/hermes-sdlc-orchestrator
