ARG HERMES_BASE_IMAGE=nousresearch/hermes-agent:latest
FROM ${HERMES_BASE_IMAGE}

USER root

ARG SUPERCRONIC_VERSION=v0.2.34
ARG TARGETARCH

RUN set -eux; \
    python3 -c 'import os, stat, urllib.request; version=os.environ.get("SUPERCRONIC_VERSION", "v0.2.34"); arch=os.environ.get("TARGETARCH", "amd64"); suffix="linux-arm64" if arch == "arm64" else "linux-amd64"; target="/usr/local/bin/supercronic"; urllib.request.urlretrieve(f"https://github.com/aptible/supercronic/releases/download/{version}/supercronic-{suffix}", target); mode=os.stat(target).st_mode; os.chmod(target, mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)'

# Hermes runs from /opt/hermes/.venv. Install the optional Langfuse SDK into
# that exact environment rather than into the system Python.
RUN uv pip install --python /opt/hermes/.venv/bin/python langfuse

# Builder LSP toolchain. These binaries live in the shared agent image, but
# only the builder profile enables the Python/TypeScript LSP servers.
RUN set -eux; \
    npm install -g 'typescript@7.0.2' 'typescript-language-server@6.0.0' 'pyright@1.1.414'; \
    typescript-language-server --version; \
    pyright --version

COPY orchestrator /opt/hermes-sdlc-orchestrator
# Add the HermeTeam plugins beside Hermes' bundled plugins so discovery does
# not depend on the container user's HOME or the /opt/data volume.
COPY hermes-plugins/hermeteam-intent-action-gate /opt/hermes/plugins/hermeteam-intent-action-gate
COPY hermes-plugins/hermeteam-openhands-bridge /opt/hermes/plugins/hermeteam-openhands-bridge
ENV PYTHONPATH=/opt/hermes-sdlc-orchestrator
