# Pin a release tag or, preferably, an immutable digest before production use.
HERMES_IMAGE=nousresearch/hermes-agent:latest

# Shared skills superset synced into a Docker volume before agent startup.
SKILLS_SUPERSET_REPO_URL=https://github.com/stanta/skills_superset.git
SKILLS_SUPERSET_REF=main

# Official GitHub MCP endpoint for the GitHub MVP. Role-specific GitHub credentials stay in secrets/hermes-*.env.
GIT_PROVIDER_MCP_URL=https://api.githubcopilot.com/mcp/

# Target repository. This bundle is configured for direct GitHub/GitLab API/MCP-only access.
# Do not clone this repository into Hermes containers.
REPOSITORY_ID=test-project
REPOSITORY_PROVIDER=github
REPOSITORY_ACCESS_MODE=github-direct-api-mcp
REPOSITORY_DEFAULT_BRANCH=main
REPOSITORY_CLONE_ALLOWED=false
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_WEB_BASE_URL=https://github.com
GITHUB_OWNER=test-project
GITHUB_REPOSITORY=test-project
GITHUB_REPOSITORY_FULL_NAME=test-project/test-project
GITHUB_REPOSITORY_HTML_URL=https://github.com/test-project/test-project
GITHUB_REPOSITORY_API_URL=https://api.github.com/repos/test-project/test-project
# API ports are bound to host loopback by compose.yaml.
PLANNER_API_PORT=18642
BUILDER_API_PORT=18643
REVIEWER_API_PORT=18644
RELEASE_API_PORT=18645
INCIDENT_API_PORT=18646
LEARNING_API_PORT=18647

OPENAI_API_KEY=CHANGE_ME_ROLE_SCOPED_LLM_TOKEN
