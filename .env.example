# Pin a release tag or, preferably, an immutable digest before production use.
HERMES_IMAGE=nousresearch/hermes-agent:latest
HERMES_ORCHESTRATOR_IMAGE=hermes-sdlc-agent-orchestrator:local

# Role-local cron orchestrator. Keep disabled until canaries pass per role.
ORCHESTRATOR_ENABLED=false
ORCHESTRATOR_PROVIDER=github
ORCHESTRATOR_CRON_SCHEDULE=*/5 * * * *
ORCHESTRATOR_MAX_STARTS_PER_TICK=1
ORCHESTRATOR_RUN_TIMEOUT_SECONDS=5400
ORCHESTRATOR_MAX_ATTEMPTS_PER_ASSIGNMENT=3
ORCHESTRATOR_RETRY_DELAY_SECONDS=300
ORCHESTRATOR_RETRY_LOST_RUNS=true
ORCHESTRATOR_RETRY_TRANSIENT_FAILURES=true
ORCHESTRATOR_APPLY_TRANSITIONS=false
ORCHESTRATOR_TRANSITION_COMMENT_ONLY=true
ORCHESTRATOR_FINAL_RESPONSE_REPAIR_ENABLED=true
ORCHESTRATOR_FINAL_RESPONSE_MODEL_REPAIR_ENABLED=true
ORCHESTRATOR_FINAL_RESPONSE_REPAIR_MODEL=hermes-json-repair
ORCHESTRATOR_FINAL_RESPONSE_REPAIR_TIMEOUT_SECONDS=120
ORCHESTRATOR_FINAL_RESPONSE_REPAIR_MAX_CHARS=200000

# Shared skills superset synced into a Docker volume before agent startup.
SKILLS_SUPERSET_REPO_URL=https://github.com/stanta/skills_superset.git
SKILLS_SUPERSET_REF=main

# Official GitHub MCP endpoint for the GitHub MVP.
GIT_PROVIDER_MCP_URL=https://api.githubcopilot.com/mcp/

# Role-specific GitHub credentials accepted by the official GitHub MCP Server.
# Compose maps these to GIT_PROVIDER_MCP_TOKEN inside each role container.
PLANNER_GITHUB_MCP_TOKEN=CHANGE_ME_PLANNER_GITHUB_MCP_TOKEN
PROJECT_MANAGER_GITHUB_MCP_TOKEN=CHANGE_ME_PROJECT_MANAGER_GITHUB_MCP_TOKEN
BUILDER_GITHUB_MCP_TOKEN=CHANGE_ME_BUILDER_GITHUB_MCP_TOKEN
REVIEWER_GITHUB_MCP_TOKEN=CHANGE_ME_REVIEWER_GITHUB_MCP_TOKEN
RELEASE_GITHUB_MCP_TOKEN=CHANGE_ME_RELEASE_GITHUB_MCP_TOKEN
INCIDENT_GITHUB_MCP_TOKEN=CHANGE_ME_INCIDENT_GITHUB_MCP_TOKEN
LEARNING_GITHUB_MCP_TOKEN=CHANGE_ME_LEARNING_GITHUB_MCP_TOKEN

# Role-local read-only discovery tokens for the cron orchestrator.
# These are distinct from the GitHub MCP credentials above.
ORCHESTRATOR_PLANNER_GITHUB_TOKEN=CHANGE_ME_READ_ONLY_GITHUB_TOKEN
ORCHESTRATOR_PROJECT_MANAGER_GITHUB_TOKEN=CHANGE_ME_READ_ONLY_GITHUB_TOKEN
ORCHESTRATOR_BUILDER_GITHUB_TOKEN=CHANGE_ME_READ_ONLY_GITHUB_TOKEN
ORCHESTRATOR_REVIEWER_GITHUB_TOKEN=CHANGE_ME_READ_ONLY_GITHUB_TOKEN
ORCHESTRATOR_RELEASE_GITHUB_TOKEN=CHANGE_ME_READ_ONLY_GITHUB_TOKEN
ORCHESTRATOR_INCIDENT_GITHUB_TOKEN=CHANGE_ME_READ_ONLY_GITHUB_TOKEN
ORCHESTRATOR_LEARNING_GITHUB_TOKEN=CHANGE_ME_READ_ONLY_GITHUB_TOKEN
ORCHESTRATOR_PLANNER_GITLAB_TOKEN=
ORCHESTRATOR_PROJECT_MANAGER_GITLAB_TOKEN=
ORCHESTRATOR_BUILDER_GITLAB_TOKEN=
ORCHESTRATOR_REVIEWER_GITLAB_TOKEN=
ORCHESTRATOR_RELEASE_GITLAB_TOKEN=
ORCHESTRATOR_INCIDENT_GITLAB_TOKEN=
ORCHESTRATOR_LEARNING_GITLAB_TOKEN=

# Shared container defaults. Compose maps these into every role container.
HERMES_MODEL_ID=deepseek/deepseek-chat-v3.1
HERMES_MODEL_BASE_URL=https://openrouter.ai/api/v1
HERMES_MODEL_OPENAI_API_KEY=
HERMES_JSON_REPAIR_MODEL_ID=
HERMES_JSON_REPAIR_MODEL_BASE_URL=
HERMES_JSON_REPAIR_OPENAI_API_KEY=
BRAVE_API_KEY=CHANGE_ME_BRAVE_SEARCH_KEY
CONTEXT7_DEFAULT_MINIMUM_TOKENS=
MDB_MCP_CONNECTION_STRING=mongodb://localhost:27017/Mongo_db
POSTGRES_MCP_CONNECTION_STRING=postgresql://readonly:CHANGE_ME@localhost:5432/postgres

# Per-role inbound Hermes API keys. bootstrap.sh replaces these placeholders.
PLANNER_API_SERVER_KEY=CHANGE_ME_GENERATED_BY_BOOTSTRAP
PROJECT_MANAGER_API_SERVER_KEY=CHANGE_ME_GENERATED_BY_BOOTSTRAP
BUILDER_API_SERVER_KEY=CHANGE_ME_GENERATED_BY_BOOTSTRAP
REVIEWER_API_SERVER_KEY=CHANGE_ME_GENERATED_BY_BOOTSTRAP
RELEASE_API_SERVER_KEY=CHANGE_ME_GENERATED_BY_BOOTSTRAP
INCIDENT_API_SERVER_KEY=CHANGE_ME_GENERATED_BY_BOOTSTRAP
LEARNING_API_SERVER_KEY=CHANGE_ME_GENERATED_BY_BOOTSTRAP

# Role model overrides. Empty values inherit the shared defaults above.
PLANNER_HERMES_MODEL_ID=
PLANNER_HERMES_MODEL_BASE_URL=
PLANNER_HERMES_MODEL_OPENAI_API_KEY=
PROJECT_MANAGER_HERMES_MODEL_ID=
PROJECT_MANAGER_HERMES_MODEL_BASE_URL=
PROJECT_MANAGER_HERMES_MODEL_OPENAI_API_KEY=
BUILDER_HERMES_MODEL_ID=qwen/qwen3-coder
BUILDER_HERMES_MODEL_BASE_URL=
BUILDER_HERMES_MODEL_OPENAI_API_KEY=
REVIEWER_HERMES_MODEL_ID=
REVIEWER_HERMES_MODEL_BASE_URL=
REVIEWER_HERMES_MODEL_OPENAI_API_KEY=
RELEASE_HERMES_MODEL_ID=
RELEASE_HERMES_MODEL_BASE_URL=
RELEASE_HERMES_MODEL_OPENAI_API_KEY=
INCIDENT_HERMES_MODEL_ID=google/gemini-2.5-flash-lite
INCIDENT_HERMES_MODEL_BASE_URL=
INCIDENT_HERMES_MODEL_OPENAI_API_KEY=
LEARNING_HERMES_MODEL_ID=google/gemini-2.5-flash-lite
LEARNING_HERMES_MODEL_BASE_URL=
LEARNING_HERMES_MODEL_OPENAI_API_KEY=

# Stable role model names exposed by each role-local API server.
PLANNER_API_SERVER_MODEL_NAME=hermes-planner
PROJECT_MANAGER_API_SERVER_MODEL_NAME=hermes-project-manager
BUILDER_API_SERVER_MODEL_NAME=hermes-builder
REVIEWER_API_SERVER_MODEL_NAME=hermes-reviewer
RELEASE_API_SERVER_MODEL_NAME=hermes-release
INCIDENT_API_SERVER_MODEL_NAME=hermes-incident
LEARNING_API_SERVER_MODEL_NAME=hermes-learning

# Optional per-role integration overrides. Empty values inherit shared defaults.
PLANNER_BRAVE_API_KEY=
PROJECT_MANAGER_BRAVE_API_KEY=
BUILDER_BRAVE_API_KEY=
REVIEWER_BRAVE_API_KEY=
RELEASE_BRAVE_API_KEY=
INCIDENT_BRAVE_API_KEY=
LEARNING_BRAVE_API_KEY=
PLANNER_CONTEXT7_DEFAULT_MINIMUM_TOKENS=
PROJECT_MANAGER_CONTEXT7_DEFAULT_MINIMUM_TOKENS=
BUILDER_CONTEXT7_DEFAULT_MINIMUM_TOKENS=
REVIEWER_CONTEXT7_DEFAULT_MINIMUM_TOKENS=
RELEASE_CONTEXT7_DEFAULT_MINIMUM_TOKENS=
INCIDENT_CONTEXT7_DEFAULT_MINIMUM_TOKENS=
LEARNING_CONTEXT7_DEFAULT_MINIMUM_TOKENS=
PLANNER_MDB_MCP_CONNECTION_STRING=
PROJECT_MANAGER_MDB_MCP_CONNECTION_STRING=
BUILDER_MDB_MCP_CONNECTION_STRING=
REVIEWER_MDB_MCP_CONNECTION_STRING=
RELEASE_MDB_MCP_CONNECTION_STRING=
INCIDENT_MDB_MCP_CONNECTION_STRING=
LEARNING_MDB_MCP_CONNECTION_STRING=
PLANNER_POSTGRES_MCP_CONNECTION_STRING=
PROJECT_MANAGER_POSTGRES_MCP_CONNECTION_STRING=
BUILDER_POSTGRES_MCP_CONNECTION_STRING=
REVIEWER_POSTGRES_MCP_CONNECTION_STRING=
RELEASE_POSTGRES_MCP_CONNECTION_STRING=
INCIDENT_POSTGRES_MCP_CONNECTION_STRING=
LEARNING_POSTGRES_MCP_CONNECTION_STRING=

# Target repository. This bundle is configured for direct GitHub/GitLab API/MCP-only access.
# Do not clone this repository into Hermes containers.
REPOSITORY_ID=test-project
REPOSITORY_PROVIDER=github
REPOSITORY_ACCESS_MODE=github-direct-api-mcp
REPOSITORY_DEFAULT_BRANCH=main
REPOSITORY_CLONE_ALLOWED=false
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_WEB_BASE_URL=https://github.com
GITHUB_OWNER=test-project
GITHUB_REPOSITORY=test-project
GITHUB_REPOSITORY_FULL_NAME=test-project/test-project
GITHUB_REPOSITORY_HTML_URL=https://github.com/test-project/test-project
GITHUB_REPOSITORY_API_URL=https://api.github.com/repos/test-project/test-project
# API ports are bound to host loopback by compose.yaml.
PLANNER_API_PORT=18642
BUILDER_API_PORT=18643
REVIEWER_API_PORT=18644
RELEASE_API_PORT=18645
INCIDENT_API_PORT=18646
LEARNING_API_PORT=18647
PROJECT_MANAGER_API_PORT=18648

OPENAI_API_KEY=CHANGE_ME_ROLE_SCOPED_LLM_TOKEN
