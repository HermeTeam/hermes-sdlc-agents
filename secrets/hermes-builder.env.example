HERMES_MODEL_ID=qwen/qwen3-coder
HERMES_MODEL_BASE_URL=
HERMES_MODEL_OPENAI_API_KEY=
API_SERVER_KEY=CHANGE_ME_GENERATED_BY_BOOTSTRAP
API_SERVER_MODEL_NAME=hermes-builder
ORCHESTRATOR_GITHUB_TOKEN=CHANGE_ME_READ_ONLY_GITHUB_TOKEN
ORCHESTRATOR_GITLAB_TOKEN=
BRAVE_API_KEY=CHANGE_ME_BRAVE_SEARCH_KEY
CONTEXT7_DEFAULT_MINIMUM_TOKENS=
MDB_MCP_CONNECTION_STRING=mongodb://localhost:27017/Mongo_db
POSTGRES_MCP_CONNECTION_STRING=postgresql://readonly:CHANGE_ME@localhost:5432/postgres

# HermeTeam Intent/Action Gate canary. Keep shadow until event quality is reviewed.
HERMETEAM_GATE_MODE=shadow
HERMETEAM_GATE_BLOCK_LEVEL=critical
HERMETEAM_GATE_LOG_PATH=/opt/data/hermeteam/intent-action-events.jsonl

# Optional Langfuse trace export. The plugin is enabled in the builder profile but is inert without keys.
HERMES_LANGFUSE_PUBLIC_KEY=
HERMES_LANGFUSE_SECRET_KEY=
HERMES_LANGFUSE_BASE_URL=https://cloud.langfuse.com
HERMES_LANGFUSE_ENV=development
HERMES_LANGFUSE_RELEASE=
HERMES_LANGFUSE_SAMPLE_RATE=1.0
HERMES_LANGFUSE_CAPTURE=sanitized
