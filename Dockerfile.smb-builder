# Small Builder image: no optional Langfuse SDK, LSP toolchain or OpenHands plugin.
# The release/bootstrap process must supply a digest-pinned base image.
ARG HERMES_BASE_IMAGE
FROM ${HERMES_BASE_IMAGE}
USER root
COPY orchestrator /opt/hermes-sdlc-orchestrator
COPY hermes-plugins/hermeteam-intent-action-gate /opt/hermes/plugins/hermeteam-intent-action-gate
ENV PYTHONPATH=/opt/hermes-sdlc-orchestrator
