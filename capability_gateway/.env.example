# Canary-only least-privilege capability gateway overlay.
# Copy required values into the repository root .env before running Compose.

# Independent admin secret used only between dashboard server and capability gateway.
CAPABILITY_ADMIN_KEY=CHANGE_ME_32_PLUS_RANDOM_CHARS

# Separate operator credential entered into the dashboard UI. Do not reuse the admin key.
DASHBOARD_GOVERNANCE_KEY=CHANGE_ME_DIFFERENT_32_PLUS_RANDOM_CHARS

# Automatic execution ceiling. SAFE | LOW | MEDIUM | HIGH | CRITICAL
CAPABILITY_MAX_AUTO_RISK=MEDIUM

# OpenAI-compatible model judge. The resolver fails closed when this dependency is unavailable.
CAPABILITY_JUDGE_BASE_URL=https://CHANGE_ME_QWEN_API_HOST/compatible-mode/v1
CAPABILITY_JUDGE_API_KEY=CHANGE_ME_QWEN_API_KEY
CAPABILITY_JUDGE_MODEL=qwen3.7-max

# Optional dynamic-request authority canary.
# The Builder uses this internal credential only to authenticate to HermeTeam. It is
# deliberately not a GitHub token. Generate it independently from CAPABILITY_ADMIN_KEY.
BUILDER_CAPABILITY_GATEWAY_KEY=CHANGE_ME_DIFFERENT_32_PLUS_RANDOM_CHARS

# GitHub App identity owned by the authority gateway. The private key path is a host
# path consumed by compose.dynamic-authority.yaml and mounted read-only into the gateway.
GITHUB_APP_ID=CHANGE_ME_GITHUB_APP_ID
GITHUB_APP_INSTALLATION_ID=CHANGE_ME_INSTALLATION_ID
GITHUB_APP_PRIVATE_KEY_FILE=./secrets/github-app-private-key.pem

# Exact execution grants are one-shot and short-lived. GitHub installation tokens may
# be cached server-side for a few minutes because HermeTeam exact grants remain the
# per-request authority boundary.
CAPABILITY_EXECUTION_GRANT_TTL_SECONDS=60
CAPABILITY_PROVIDER_TOKEN_CACHE_SECONDS=300
CAPABILITY_PROVIDER_TIMEOUT_SECONDS=10
CAPABILITY_UPSTREAM_TIMEOUT_SECONDS=180
